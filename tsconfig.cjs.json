{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES6"],
    "target": "ES6",
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "rootDir": "./src",
    "outDir": "./dist/cjs",
    "declarationDir": "./dist/cjs",
    "paths": {}
  },
  "exclude": ["src/**/*.test.ts", "docs/**"],
  "include": ["src/**/*.ts"]
}
