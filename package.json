{
  "name": "stream-watch",
  "author": "Kristopher Reeves",
  "license": "MIT",
  "version": "1.0.0",
  "description": "Track the online status of a stream and configure when and how to act on changes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myndzi/stream-watch.git"
  },
  "keywords": [
    "typescript",
    "twitch",
    "stream",
    "pubsub",
    "eventsub",
    "polling",
    "watch"
  ],
  "bugs": {
    "url": "https://github.com/myndzi/stream-watch/issues"
  },
  "homepage": "https://github.com/myndzi/stream-watch#readme",
  "scripts": {
    "test": "vitest run",
    "clean": "rm -rf ./dist/*",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs && pnpm run gen-readme && grep -v \"exit 1\" package.json > ./dist/package.json && cp ./LICENSE ./dist/LICENSE",
    "build:esm": "tsc -p ./tsconfig.esm.json",
    "build:cjs": "tsc -p ./tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > ./dist/cjs/package.json",
    "gen-readme": "partialtongue -i docs/README.md -o dist/README.md --start '//*' --end '*//\n' && cp dist/README.md ./README.md",
    "prepack": "printf '%s\\n\\n' 'use pnpm run release' && exit 1",
    "release": "pnpm run build && ./test-esm-cjs && (cd dist && npm publish)"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    "./cjs": {
      "require": "./cjs/index.js"
    },
    "./cjs/*": {
      "require": "./cjs/*"
    },
    "./cjs/policy/*": {
      "require": "./cjs/policy/*"
    },
    ".": {
      "import": "./index.js"
    },
    "./*": {
      "import": "./*"
    },
    "./policy/*": {
      "import": "./policy/*"
    }
  },
  "devDependencies": {
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/eventsub-ws": "^8.2.0",
    "@types/node": "^18.19.130",
    "partialtongue": "^1.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
